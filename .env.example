# ==============================================================================
# AI Travel Copilot - Environment Configuration
# ==============================================================================

# Application
APP_NAME="AI Travel Copilot"
APP_ENV="development" # development, staging, production
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkeychangeinproductionmustbe64byteslengthforsecurity"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","*"]

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/travel_copilot_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_copilot_db"
# Fallback SQLite DB for zero-config local testing if PostgreSQL is unavailable
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./travel_copilot.db"
USE_SQLITE_FALLBACK=false

# Redis Cache & Session
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=false # Set to true when redis server is active

# LLM & AI Providers (Multi-provider support with fallback engine)
AI_PROVIDER="openai" # openai, anthropic, gemini, or mock
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"

# RAG & Embeddings
EMBEDDING_PROVIDER="openai" # openai, local, or mock
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Weather Provider
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"

# Map & Geocoding
MAP_PROVIDER="osm" # osm (OpenStreetMap), mapbox, google
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# Voice AI
VOICE_STT_PROVIDER="openai" # openai (whisper), local, browser
VOICE_TTS_PROVIDER="openai" # openai (tts-1), local, browser
